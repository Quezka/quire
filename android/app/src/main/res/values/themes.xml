<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window before it does. -->
    <style name="Theme.Quire" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F6F5FC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- the capture card floats over whatever was on screen -->
    <style name="Theme.Quire.Capture" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
